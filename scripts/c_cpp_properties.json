{
    "version": 4,
    "configurations": [
        {
            "name": "g++",
            "includePath": ["./include"],
            "browse": {
                "limitSymbolsToIncludedHeaders": true,
                "path": ["./include", "./src"]
            },

            "defines": $(Defines),

            "cStandard": "c17",
            "cppStandard": "c++11"
        }
    ]
}